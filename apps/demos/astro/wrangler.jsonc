{
	"main": "@astrojs/cloudflare/entrypoints/server",
	"name": "astro-layoutgrid-demo",
	"compatibility_date": "2025-12-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
}
