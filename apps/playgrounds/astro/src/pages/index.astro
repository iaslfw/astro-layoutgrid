---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<h1>astro-layoutgrid — Playground</h1>
	<p>
		Nackte Astro-Instanz ohne CSS-Framework und ohne Adapter. Das Overlay kommt aus dem Workspace (<code
			>packages/astro-layoutgrid</code
		>) und wird mit <kbd>Cmd/Ctrl + Shift + G</kbd> umgeschaltet.
	</p>
	<p>Das blaue Quadrat ist mittig positioniert und dient als Bezugspunkt fuer die Ausrichtung.</p>

	<div class="reference"></div>
</Layout>

<style>
	.reference {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1000;
		width: 100px;
		height: 100px;
		background: blue;
		transform: translate(-50%, -50%);
	}
</style>
