---
import { video } from '@/copy/video';
---

<figure class="surface mx-auto w-full max-w-4xl overflow-hidden p-2 sm:p-3">
	<video
		class="block w-full rounded-[calc(var(--radius)-0.5rem)]"
		style={`aspect-ratio: ${video.width} / ${video.height}`}
		width={video.width}
		height={video.height}
		poster={video.poster}
		aria-label={video.label}
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		data-demo-video>
		{video.sources.map((source) => <source src={source.src} type={source.type} />)}
	</video>
	<figcaption class="sr-only">{video.label}</figcaption>
</figure>

<script>
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

	function apply() {
		for (const element of document.querySelectorAll<HTMLVideoElement>('[data-demo-video]')) {
			if (reduced.matches) {
				element.pause();
				element.controls = true;
				element.removeAttribute('loop');
			} else {
				element.controls = false;
				element.setAttribute('loop', '');
				void element.play().catch(() => undefined);
			}
		}
	}

	apply();
	reduced.addEventListener('change', apply);
</script>
