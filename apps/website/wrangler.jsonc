{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "layoutgrid-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
}
