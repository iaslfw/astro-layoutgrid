{
  "main": "dist/_worker.js/index.js",
  "name": "astro-layoutgrid-demo",
  "compatibility_date": "2025-12-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
}
