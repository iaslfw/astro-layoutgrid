{
	"name": "astro-layoutgrid-monorepo",
	"private": true,
	"type": "module",
	"description": "Monorepo für astro-layoutgrid: das Package, die Demo und ein Playground.",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/*",
		"apps/website",
		"apps/demos/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace astro-layoutgrid-website",
		"dev:demo": "npm run dev --workspace astro-layoutgrid-demo",
		"build": "npm run build --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"ship:website": "npm run ship --workspace astro-layoutgrid-website"
	},
	"devDependencies": {
		"oxlint": "1.82.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
