{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"declaration": true,
		"declarationMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
