---
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <section
    class="mx-auto max-w-full px-3 pt-40 md:max-w-[47.5vw] lg:max-w-[32vw]"
  >
    <div class="flex h-28 w-full flex-col gap-10 lg:gap-16">
      <div>
        <h1 class="text-headline">Changelog</h1>
        <p class="text-body_secondary">Have a look at our recent changes</p>
      </div>

      <div class="flex w-full flex-col gap-5">
        <a href="#test" class="relative w-full" data-element="expandable">
          <div>
            <div>
              <h2 class="text-title">Version 1.2.0 out now</h2>
              <p class="text-body_secondary">
                Now with typescript-intellisense and...
              </p>
            </div>

            <div
              class="bg-highlight absolute top-0 right-0 max-w-fit rounded-sm px-2"
            >
              <p class="text-xs">release</p>
            </div>
          </div>

          <div class="hidden w-full">
            <p>
              Lorem ipsum, dolor sit amet consectetur adipisicing elit. Magni,
              in autem veritatis ullam inventore, natus, ipsum deserunt
              architecto veniam totam unde commodi exercitationem earum optio
              dolores! Nesciunt atque voluptatum officia!
            </p>
          </div>
        </a>
        <a href="#test" class="relative w-full" data-element="expandable">
          <div>
            <div>
              <h2 class="text-title">Version 1.1.0 out now</h2>
              <p class="text-body_secondary">
                Now with typescript-intellisense and...
              </p>
            </div>

            <div
              class="bg-highlight absolute top-0 right-0 max-w-fit rounded-sm px-2"
            >
              <p class="text-xs">release</p>
            </div>
          </div>

          <div class="hidden w-full">
            <p>
              Lorem ipsum, dolor sit amet consectetur adipisicing elit. Magni,
              in autem veritatis ullam inventore, natus, ipsum deserunt
              architecto veniam totam unde commodi exercitationem earum optio
              dolores! Nesciunt atque voluptatum officia!
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
